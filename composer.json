{
    "require": {
        "php": "^8.2",
        "phpmailer/phpmailer": "^6.8",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "App\\Routes\\": "routes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "migrate": "php scripts/migrate.php migrate",
        "migrate:rollback": "php scripts/migrate.php rollback",
        "migrate:status": "php scripts/migrate.php status",
        "seed": "php scripts/seed.php",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "test:tenancy": "php tests/Integration/TenancyIsolationSmoke.php",
        "test:user-roles": "php tests/Integration/UserRoleIsolationSmoke.php",
        "analyse": "phpstan analyse --memory-limit=512M",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "check": ["@lint", "@analyse", "@test"]
    }
}
