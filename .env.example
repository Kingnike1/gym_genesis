# Aplicação
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:83
APP_FORCE_HTTPS=false
APP_SECRET=

# Banco de dados da aplicação
DB_HOST=db
DB_PORT=3306
DB_NAME=gym_genesis
DB_USER=gym_genesis_app
DB_PASSWORD=

# Administração do MariaDB — não utilizar na aplicação
DB_ROOT_PASSWORD=

# E-mail (PHPMailer)
MAIL_HOST=smtp.example.com
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Gym Genesis"
